func createEmptyMinefield(prefs preferences) [][]cell {
	minefield := make([][]cell, prefs.height)

	for y := range minefield {
		minefield[y] = make([]cell, prefs.width)
		for x := range minefield[y] {
			minefield[y][x] = cell{}
		}
	}
	return minefield
}

func debugPrintMinefield(minefield [][]cell, cursorPos [2]int) {
	s := strings.Builder{}
	for y := range minefield {
		for x, c := range minefield[y] {
			if x == cursorPos[0] && y == cursorPos[1] {
				s.WriteString("C")
				continue
			}
			if c.isMine {
				s.WriteString("M")
			} else {
				s.WriteString("-")
			}
		}
		s.WriteString("\n")
	}
	fmt.Println(s.String())
}

func debugPrintMinefieldActual(minefield [][]cell, cursorPos [2]int) {
	s := strings.Builder{}
	for y := range minefield {
		for x, c := range minefield[y] {
			if x == cursorPos[0] && y == cursorPos[1] {
				s.WriteString("C")
			} else if c.isFlagged {
				s.WriteString("F")
			} else if c.isMine {
				s.WriteString("M")
			} else if c.isRevealed {
				s.WriteString(strconv.Itoa(countAdjacentMines(x, y, minefield)))
			} else {
				s.WriteString("-")
			}
		}
		s.WriteString("\n")
	}
	fmt.Println(s.String())
}

func placeMinesSkipCursor(minefield [][]cell, prefs preferences, cursorPos [2]int) {
	if prefs.numberOfMines >= prefs.width*prefs.height {
		panic(fmt.Sprintf("Too many mines for the given field size: %dx%d with %d mines", prefs.width, prefs.height, prefs.numberOfMines))
	}
	if minefield == nil {
		panic("Minefield is nil")
	}

	positions := make([][2]int, 0, prefs.width*prefs.height)
	for y := 0; y < prefs.height; y++ {
		for x := 0; x < prefs.width; x++ {
			// don't place mines on the cursor
			if x == cursorPos[0] && y == cursorPos[1] {
				continue
			}
			// don't place mines around the cursor
			if (x >= cursorPos[0]-1 && x <= cursorPos[0]+1) && (y >= cursorPos[1]-1 && y <= cursorPos[1]+1) {
				continue
			}
			positions = append(positions, [2]int{x, y})
		}
	}

	rand.New(rand.NewSource(time.Now().UnixNano()))
	rand.Shuffle(len(positions), func(i, j int) { positions[i], positions[j] = positions[j], positions[i] })

	for i := 0; i < prefs.numberOfMines; i++ {
		x, y := positions[i][0], positions[i][1]
		minefield[y][x].isMine = true
	}
}

func countAdjacentMines(x, y int, minefield [][]cell) int {
	adj := 0
	forEachSurroundingCellDo(x, y, minefield, func(x, y int, m [][]cell) {
		if m[y][x].isMine {
			adj++
		}
	})
	return adj
}

func forEachSurroundingCellDo(x, y int, minefield [][]cell, do func(x, y int, m [][]cell)) {
	w := len(minefield[0])
	h := len(minefield)
	for dx := -1; dx <= 1; dx++ {
		for dy := -1; dy <= 1; dy++ {
			if (dx == 0 && dy == 0) || x+dx < 0 || x+dx > w-1 || y+dy < 0 || y+dy > h-1 {
				continue
			}
			do(x+dx, y+dy, minefield)
		}
	}
}

func countAdjacentHidden(x, y int, m [][]cell) int {
	adj := 0
	forEachSurroundingCellDo(x, y, m, func(x, y int, minefield [][]cell) {
		if !minefield[y][x].isRevealed && !minefield[y][x].isFlagged {
			adj++
		}
	})
	return adj
}

func countAdjacentFlags(x, y int, m [][]cell) int {
	adj := 0
	forEachSurroundingCellDo(x, y, m, func(x, y int, minefield [][]cell) {
		if minefield[y][x].isFlagged {
			adj++
		}
	})
	return adj
}

func autoSweep(x, y int, m [][]cell) {
	forEachSurroundingCellDo(x, y, m, func(x, y int, m [][]cell) {
		cell := m[y][x]
		if !cell.isRevealed && !cell.isFlagged {
			sweep(x, y, m, true, make(Set[point]))
		}
	})
}

func sweep(x, y int, minefield [][]cell, userInitiatedSweep bool, swept Set[point]) {
	c := minefield[y][x]

	if c.isRevealed && userInitiatedSweep {
		adjMines := countAdjacentMines(x, y, minefield)
		adjFlags := countAdjacentFlags(x, y, minefield)
		if adjFlags >= adjMines {
			autoSweep(x, y, minefield)
		}
		return
	}

	if c.isMine {
		if userInitiatedSweep {
			debugPrintMinefield(minefield, [2]int{-1, -1})
			panic("Mine was swept!")
		}
		return
	}

	touching := countAdjacentMines(x, y, minefield)

	p := point{x: x, y: y}
	if touching == 0 && !swept.Has(p) {
		swept.Add(p)
		forEachSurroundingCellDo(x, y, minefield, func(x, y int, m [][]cell) {
			sweep(x, y, m, false, swept)
		})
	}

	c.isRevealed = true
}

/* ----------------------------------------------------------------------
* Minesweeper solver, used to ensure the generated grids are
* solvable without having to take risks.
 */
func solveMinesweeper(minefield [][]cell, startingPoint [2]int) bool {
	//minefield[0][0].isMine = true
	//debugPrintMinefield(minefield, [2]int{-1, -1})

	// If the starting point is a mine, panic
	if minefield[startingPoint[1]][startingPoint[0]].isMine {
		panic("Starting point is a mine! Wrong starting point or minefield.")
	}
	//minefield[startingPoint[1]][startingPoint[0]]
	sweep(startingPoint[1], startingPoint[0], minefield, true, make(Set[point]))
	for {
		progress := false

		for y := range minefield {
			for x := range minefield[y] {
				c := minefield[y][x]
				if c.isRevealed {
					adjMines := countAdjacentMines(x, y, minefield)
					adjFlags := countAdjacentFlags(x, y, minefield)
					adjHidden := countAdjacentHidden(x, y, minefield)

					// Flag all adjacent hidden cells if the number of adjacent mines equals the number of adjacent flags plus hidden cells
					if adjMines == adjFlags+adjHidden {
						forEachSurroundingCellDo(x, y, minefield, func(x, y int, m [][]cell) {
							if !m[y][x].isRevealed && !m[y][x].isFlagged {
								m[y][x].isFlagged = true
								progress = true
							}
						})
					}

					// Reveal all adjacent hidden cells if the number of adjacent flags equals the number of adjacent mines
					if adjMines == adjFlags {
						fmt.Printf("Revealing %d hidden cells around (%d, %d)\n", adjHidden, x, y)
						forEachSurroundingCellDo(x, y, minefield, func(x, y int, m [][]cell) {
							if !m[y][x].isRevealed && !m[y][x].isFlagged {
								sweep(x, y, m, true, make(Set[point]))
								progress = true
							}
						})
					}
				}
			}
		}

		debugPrintMinefieldActual(minefield, startingPoint)

		// If no progress was made, break the loop
		if !progress {
			break
		}
	}

	debugPrintMinefield(minefield, [2]int{-1, -1})

	// check if there are any unrevealed cells left
	for y := range minefield {
		for x := range minefield[y] {
			if !minefield[y][x].isRevealed && !minefield[y][x].isFlagged {
				return false
			}
		}
	}
	return true
}

